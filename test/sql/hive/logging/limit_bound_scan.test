# name: test/sql/hive/logging/limit_bound_scan.test
# description: a Hive scan with only a constant LIMIT (and OFFSET) and projections above it is planned without loading its partitions, sampling its files or reading footers; every other plan shape is estimated as before
# group: [logging]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.lbs_parts;

statement ok
DROP TABLE IF EXISTS my_datalake.default.lbs_flat;

statement ok
CREATE TABLE my_datalake.default.lbs_parts (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.lbs_parts VALUES (1, 'x'), (2, 'y'), (3, 'z');

statement ok
CREATE TABLE my_datalake.default.lbs_flat (id INTEGER);

statement ok
INSERT INTO my_datalake.default.lbs_flat VALUES (1), (2), (3);

statement ok
attach '{GLUE_CATALOG_ID}' as lbs (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
CREATE VIEW lbs_view AS SELECT id, dt FROM lbs.default.lbs_parts;

statement ok
CREATE VIEW lbs_filtered_view AS SELECT id, dt FROM lbs.default.lbs_parts WHERE id > 1;

statement ok
CALL enable_logging(['HTTP', 'GlueScan'], storage := 'memory');

statement ok
SET glue_get_partitions_segments = 1;

# What planning cost: the GetPartitions requests, the partition loads, samples and listings of the scans
statement ok
CREATE TEMP MACRO planning_cost() AS (
    SELECT (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions') ||
           ' ' || count(*) FILTER (event = 'partitions') ||
           ' ' || count(*) FILTER (event = 'sample') ||
           ' ' || count(*) FILTER (event = 'listing')
    FROM duckdb_logs_parsed('GlueScan'));

# ---- limit-bound: nothing is loaded while planning ---------------------------------------------------------------

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts LIMIT 1;

query I
SELECT planning_cost();
----
0 0 0 0

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT id + 1, upper(dt) FROM lbs.default.lbs_parts LIMIT 2 OFFSET 1;

query I
SELECT planning_cost();
----
0 0 0 0

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM (SELECT id FROM lbs.default.lbs_parts LIMIT 5) LIMIT 1;

query I
SELECT planning_cost();
----
0 0 0 0

# the plan through a view still has the shape
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs_view LIMIT 1;

query I
SELECT planning_cost();
----
0 0 0 0

# an unpartitioned table is neither sampled nor counted from its footers
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_flat LIMIT 1;

query I
SELECT planning_cost();
----
0 0 0 0

# EXPLAIN ANALYZE runs the scan, which loads what it reads, but planning still samples nothing
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN ANALYZE SELECT * FROM lbs.default.lbs_parts LIMIT 1;

query I
SELECT count(*) FROM duckdb_logs_parsed('GlueScan') WHERE event = 'sample';
----
0

# ---- limit-bound: the same rows ----------------------------------------------------------------------------------

statement ok
CALL truncate_duckdb_logs();

query I
SELECT id IN (1, 2, 3) FROM lbs.default.lbs_parts LIMIT 1;
----
true

query I
SELECT count(*) FROM duckdb_logs_parsed('GlueScan') WHERE event = 'sample';
----
0

query II
SELECT id IN (1, 2, 3), dt IN ('x', 'y', 'z') FROM lbs.default.lbs_parts LIMIT 2 OFFSET 1;
----
true	true
true	true

query I
SELECT id FROM lbs.default.lbs_parts LIMIT 5 OFFSET 3;
----

query I rowsort
SELECT id FROM lbs.default.lbs_parts LIMIT 10;
----
1
2
3

query I rowsort
SELECT id FROM lbs.default.lbs_flat LIMIT 10;
----
1
2
3

query I
SELECT id FROM lbs.default.lbs_parts LIMIT 0;
----

# ---- not limit-bound: estimated as before ------------------------------------------------------------------------

# Each of these loads the partitions while planning
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts WHERE id > 1 LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts a JOIN lbs.default.lbs_parts b USING (id) LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT dt, count(*) FROM lbs.default.lbs_parts GROUP BY dt LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT count(*) FROM (SELECT * FROM lbs.default.lbs_parts LIMIT 1);

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts ORDER BY id LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT DISTINCT dt FROM lbs.default.lbs_parts LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT id, row_number() OVER () FROM lbs.default.lbs_parts LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts USING SAMPLE 2 ROWS LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts QUALIFY row_number() OVER () = 1 LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT id FROM lbs.default.lbs_parts UNION ALL SELECT id FROM lbs.default.lbs_parts LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT (SELECT max(f.id) FROM lbs.default.lbs_parts f WHERE f.id = p.id) FROM lbs.default.lbs_parts p LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts LIMIT 50%;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts LIMIT (SELECT 1);

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs_filtered_view LIMIT 1;

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

# stats() shows the statistics, so they are read as before, also under a cast
statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT stats(dt)::VARCHAR FROM lbs.default.lbs_parts LIMIT 1;

query I
SELECT planning_cost() != '0 0 0 0';
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT stats(dt)::VARCHAR FROM lbs.default.lbs_parts LIMIT 1;
----
{'has_no_null': true, 'has_null': true, 'has_unicode': true}

query I
SELECT count(*) FILTER (event = 'partitions') > 0 FROM duckdb_logs_parsed('GlueScan');
----
true

# the rows of the shapes above are the scan's own
query II rowsort
SELECT * FROM lbs.default.lbs_parts WHERE id > 1 LIMIT 5;
----
2	y
3	z

query II
SELECT * FROM lbs.default.lbs_parts ORDER BY id LIMIT 1;
----
1	x

# ---- partitions a cache already holds: estimated as before -------------------------------------------------------

statement ok
BEGIN;

query I
SELECT count(*) FROM lbs.default.lbs_parts;
----
3

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts LIMIT 1;

query II
SELECT (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions'),
       count(*) FILTER (event = 'partitions')
FROM duckdb_logs_parsed('GlueScan');
----
0	1

query I
SELECT id IN (1, 2, 3) FROM lbs.default.lbs_parts LIMIT 1;
----
true

statement ok
COMMIT;

statement ok
SET glue_metadata_cache_scope = 'connection';

query I
SELECT count(*) FROM lbs.default.lbs_parts;
----
3

statement ok
CALL truncate_duckdb_logs();

statement ok
EXPLAIN SELECT * FROM lbs.default.lbs_parts LIMIT 1;

query II
SELECT (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions'),
       count(*) FILTER (event = 'partitions')
FROM duckdb_logs_parsed('GlueScan');
----
0	1

statement ok
RESET glue_metadata_cache_scope;

statement ok
CALL disable_logging();

statement ok
DROP VIEW lbs_view;

statement ok
DROP VIEW lbs_filtered_view;

statement ok
DROP TABLE my_datalake.default.lbs_parts;

statement ok
DROP TABLE my_datalake.default.lbs_flat;
