# name: test/sql/hive/hive_scan/limit_bound_scan.test
# description: SELECT * ... LIMIT n on a partitioned table pages through its partitions: LIMIT 1 costs one GetPartitions page of 10 partitions and one listing (when nothing opens files ahead of the scan), a LIMIT past the table's rows pages through every partition and returns every row, and a scan the planner does not mark loads every partition. test/unittest/hive_lazy_partitions_test.cpp tests the paging itself
# group: [hive_scan]

require httpfs

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_FAULT_ENDPOINT

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# the fault proxy pages GetPartitions of a fault_paged_partitions* database by MaxResults and NextToken, as AWS does
statement ok
attach '{GLUE_CATALOG_ID}' as paged (
    TYPE glue,
    ENDPOINT '{GLUE_FAULT_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP SCHEMA IF EXISTS my_datalake.fault_paged_partitions_limit CASCADE;

statement ok
CREATE SCHEMA paged.fault_paged_partitions_limit;

statement ok
CREATE TABLE paged.fault_paged_partitions_limit.t (id INTEGER, k VARCHAR) PARTITIONED BY (k);

# 25 partitions of one file each: pages of 10 and 100 partitions hold them
statement ok
INSERT INTO paged.fault_paged_partitions_limit.t SELECT i, 'p' || lpad(i::VARCHAR, 2, '0') FROM range(25) t(i);

statement ok
CALL enable_logging(['HTTP', 'GlueScan'], storage := 'memory');

statement ok
SET glue_get_partitions_segments = 1;

# the listed prefix is in the URL's query string, which HTTP logs redact by default
statement ok
SET redact_http_logs = false;

# The GetPartitions requests, the partitions their pages held, the loads of every partition, the listings of the
# scan and the S3 list requests
statement ok
CREATE TEMP MACRO scan_cost() AS (
    SELECT (SELECT count(*) FROM glue_requests() WHERE operation = 'AWSGlue.GetPartitions') ||
           ' ' || coalesce(sum(partitions) FILTER (event = 'partition_page'), 0) ||
           ' ' || count(*) FILTER (event = 'partitions') ||
           ' ' || count(*) FILTER (event = 'listing') ||
           ' ' || (SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.url LIKE '%list-type=2%')
    FROM duckdb_logs_parsed('GlueScan'));

# ---- LIMIT 1 with DuckDB's defaults: files opened ahead page further, but never load every partition --------------

statement ok
CALL truncate_duckdb_logs();

query I
SELECT k = 'p' || lpad(id::VARCHAR, 2, '0') FROM paged.fault_paged_partitions_limit.t LIMIT 1;
----
true

query I
SELECT split_part(scan_cost(), ' ', 3);
----
0

# ---- LIMIT 1: the first page and the first partition's listing ---------------------------------------------------

# the progress bar (GetFileCount(100)) and the scan's read-ahead (it opens files ahead of decoding) ask for more files
# than the LIMIT needs, and the list pages to give them
statement ok
SET enable_progress_bar = false;

statement ok
SET read_ahead_depth = 0;

statement ok
CALL truncate_duckdb_logs();

# the row is in the file of its own partition
query I
SELECT k = 'p' || lpad(id::VARCHAR, 2, '0') FROM paged.fault_paged_partitions_limit.t LIMIT 1;
----
true

query I
SELECT scan_cost();
----
1 10 0 1 1

statement ok
RESET enable_progress_bar;

statement ok
RESET read_ahead_depth;

# ---- a LIMIT past the table's rows: every page, every row ---------------------------------------------------------

statement ok
CALL truncate_duckdb_logs();

query II rowsort
SELECT * FROM paged.fault_paged_partitions_limit.t LIMIT 1000;
----
0	p00
1	p01
10	p10
11	p11
12	p12
13	p13
14	p14
15	p15
16	p16
17	p17
18	p18
19	p19
2	p02
20	p20
21	p21
22	p22
23	p23
24	p24
3	p03
4	p04
5	p05
6	p06
7	p07
8	p08
9	p09

# the second page is the last: the pages are the partitions, without loading them again
query I
SELECT split_part(scan_cost(), ' ', 1) || ' ' || split_part(scan_cost(), ' ', 2) || ' ' || split_part(scan_cost(), ' ', 3);
----
2 25 0

# ---- not limit bound: every partition is loaded ---------------------------------------------------------------------

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM paged.fault_paged_partitions_limit.t;
----
25

query I
SELECT count(*) FILTER (event = 'partition_page') || ' ' || count(*) FILTER (event = 'partitions') FROM duckdb_logs_parsed('GlueScan');
----
0 1

statement ok
DROP SCHEMA my_datalake.fault_paged_partitions_limit CASCADE;
