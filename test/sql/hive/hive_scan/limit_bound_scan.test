# name: test/sql/hive/hive_scan/limit_bound_scan.test
# description: a scan marked limit bound (every scan while glue_test_limit_bound_scans is set, until the planner marks them) returns the rows an unmarked scan returns, and counts exactly. test/unittest/hive_lazy_partitions_test.cpp tests the paging itself, which the cardinality estimate of a planned query still precedes
# group: [hive_scan]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.limit_bound;

statement ok
CREATE TABLE my_datalake.default.limit_bound (id INTEGER, k VARCHAR) PARTITIONED BY (k);

statement ok
INSERT INTO my_datalake.default.limit_bound SELECT i, 'p' || (i % 25) FROM range(100) t(i);

statement ok
CREATE TEMP TABLE unmarked AS SELECT * FROM my_datalake.default.limit_bound;

statement ok
SET VARIABLE glue_test_limit_bound_scans = true;

query I
SELECT count(*) FROM my_datalake.default.limit_bound;
----
100

# a limit of at least the table's rows returns every row, in any order
query II
SELECT count(*), count(DISTINCT id) FROM (SELECT * FROM my_datalake.default.limit_bound LIMIT 1000) t SEMI JOIN unmarked USING (id, k);
----
100	100

query I
SELECT count(*) FROM (SELECT * FROM my_datalake.default.limit_bound LIMIT 1) t SEMI JOIN unmarked USING (id, k);
----
1

statement ok
SET VARIABLE glue_test_limit_bound_scans = false;

statement ok
DROP TABLE my_datalake.default.limit_bound;
